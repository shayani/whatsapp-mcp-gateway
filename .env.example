# Servidor e Portas
PORT=8765
HOST=0.0.0.0
DATA_DIR=./data
LOG_LEVEL=info

# Transcrição de Áudio (Groq padrão ou OpenAI)
# Você também pode definir a chave Groq diretamente pela Interface Web em :8765
GROQ_API_KEY=
OPENAI_API_KEY=

# Segurança Opcional
# Se definido, conexões ao MCP via SSE exigem Header: Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=

# Se definido, acesso ao painel web exige autenticação
DASHBOARD_PASSWORD=

# Modo somente-leitura (impede envio acidental de mensagens pelo WhatsApp)
READ_ONLY=true
