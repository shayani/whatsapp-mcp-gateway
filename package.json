{
  "name": "whatsapp-gateway",
  "version": "1.0.0",
  "description": "WhatsApp Baileys Gateway with SQLite WAL, Async Whisper Transcription, and Model Context Protocol (MCP) Server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "build:server": "tsc",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "mcp:stdio": "tsx src/mcp/stdio.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@whiskeysockets/baileys": "^6.7.19",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "groq-sdk": "^0.15.0",
    "openai": "^4.86.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
